# Copy this blank template to .env; fill the key locally, never in this template.
# Backend launch scripts load this file. The frontend never reads it.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=1
LLM_MAX_TOKENS=4096
AGENT_TIMEOUT_SECONDS=90
DATABASE_URL=sqlite:///./data/componentmatch.db
